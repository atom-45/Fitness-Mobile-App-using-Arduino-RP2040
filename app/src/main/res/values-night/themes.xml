<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BluetoothFitnessApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/deep_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Base.Theme.BluetoothFitnessApplication" parent="Theme.BluetoothFitnessApplication" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/deep_navy</item>
        <item name="postSplashScreenTheme">@style/Theme.BluetoothFitnessApplication</item>
    </style>

    <style name="Base.Theme.ChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/orange_blaze</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipStrokeColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/marvel</item>
    </style>

    <style name="Base.Theme.StopButton" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/marvel</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundColor">@color/crimson_red</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
